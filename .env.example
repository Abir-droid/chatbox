# Copy to .env for local development (never commit .env).
# In Coolify, set these under the app's Environment Variables instead.

# URL subpath the app is served from. Leave empty to serve from the root.
# Production: https://abirdroid.ddns.net/chatbox  ->  APPLICATION_ROOT=/chatbox
APPLICATION_ROOT=

PORT=3000
HOST=0.0.0.0

# PostgreSQL connection string (required).
DATABASE_URL=postgres://chatbox:change-me@localhost:5432/chatbox

# Only if your PostgreSQL requires TLS:
# PGSSL=true
# PGSSL_REJECT_UNAUTHORIZED=false
