{
  "name": "chatbox",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted real-time chat (Express + Socket.IO + PostgreSQL) that runs under a URL subpath such as /chatbox",
  "main": "server.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "heic-convert": "^2.1.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14",
    "socket.io-client": "^4.8.4"
  }
}
