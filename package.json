{
  "name": "chatbox",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted real-time chat (Express + Socket.IO + PostgreSQL) that runs under a URL subpath such as /chatbox",
  "main": "server.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test",
    "generate-icons": "node generate-icons.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "heic-convert": "^2.1.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "pg-mem": "^3.0.14"
  }
}
