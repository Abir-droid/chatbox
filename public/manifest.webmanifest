{
  "name": "Chatbox",
  "short_name": "Chatbox",
  "description": "Fast, private real-time messaging, voice & video calling",
  "start_url": "{{BASE}}/?source=pwa",
  "scope": "{{BASE}}/",
  "id": "{{BASE}}/?source=pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#0b101b",
  "background_color": "#0b101b",
  "lang": "en",
  "dir": "ltr",
  "categories": ["social", "communication", "chat", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "{{BASE}}/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{BASE}}/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{BASE}}/static/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{{BASE}}/static/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{{BASE}}/static/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "{{BASE}}/static/icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Chat",
      "short_name": "New Chat",
      "description": "Start a new conversation",
      "url": "{{BASE}}/?action=new-chat",
      "icons": [
        {
          "src": "{{BASE}}/static/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
